<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Interface contract shared by sim, hal and the controller. Change all three together.
       Arm joints use Damiao MIT mode: tau = kp*(q_des-q) + kd*(dq_des-dq) + tau_ff. -->

  <xacro:macro name="arm_joint_interfaces" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="stiffness"/>
      <command_interface name="damping"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel_joint_interfaces" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="ros2_control" params="use_sim">
    <ros2_control name="system" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <plugin>T1::sim::SimSystem</plugin>
          <param name="mjcf_path">$(find wbc)/mjcf/scene.xml</param>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>T1::hal::HardwareSystem</plugin>
          <param name="motors_config">$(find wbc)/motors.yaml</param>
        </xacro:unless>
      </hardware>

      <xacro:arm_joint_interfaces name="arm_joint1"/>
      <xacro:arm_joint_interfaces name="arm_joint2"/>
      <xacro:arm_joint_interfaces name="arm_joint3"/>
      <xacro:arm_joint_interfaces name="arm_joint4"/>
      <xacro:arm_joint_interfaces name="arm_joint5"/>
      <xacro:arm_joint_interfaces name="arm_joint6"/>
      <xacro:wheel_joint_interfaces name="wheel_left_joint"/>
      <xacro:wheel_joint_interfaces name="wheel_right_joint"/>

      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
        <param name="frame_id">imu_link</param>
      </sensor>

      <sensor name="ft_sensor">
        <state_interface name="force.x"/>
        <state_interface name="force.y"/>
        <state_interface name="force.z"/>
        <state_interface name="torque.x"/>
        <state_interface name="torque.y"/>
        <state_interface name="torque.z"/>
        <param name="frame_id">ft_sensor</param>
      </sensor>
    </ros2_control>
  </xacro:macro>

</robot>
