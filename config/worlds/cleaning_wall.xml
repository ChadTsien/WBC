<mujoco model="cleaning_wall">
  <option timestep="0.001" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.28 0.3" rgb2="0.32 0.35 0.38"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.05"/>
  </asset>

  <!-- Dimensions are placeholders until the real cleaning site is measured. -->
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="20 20 0.1" material="grid" friction="1.0 0.005 0.0001"/>

    <!-- Vertical wall to clean, facing -X. -->
    <geom name="wall" type="box" pos="2.0 0 1.0" size="0.05 2.0 1.0" rgba="0.8 0.8 0.75 1"/>

    <!-- 20 deg slope surface for the inclined-contact test. -->
    <geom name="slope" type="box" pos="1.5 -2.5 0.25" euler="0 20 0" size="0.4 0.4 0.02"
          rgba="0.7 0.75 0.8 1"/>

    <!-- Wall-mounted brush dock. -->
    <body name="brush_dock" pos="0 2.0 0.6">
      <geom name="dock" type="box" size="0.15 0.05 0.1" rgba="0.3 0.5 0.7 1"/>
      <site name="dock_slot_0" pos="-0.06 -0.05 0" size="0.01"/>
      <site name="dock_slot_1" pos="0.06 -0.05 0" size="0.01"/>
    </body>
  </worldbody>
</mujoco>
